<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- run on a newer .NET if .NET 8 isn't installed -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- where "dotnet user-secrets" keeps the connection string -->
    <UserSecretsId>isp-management-gin401</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADO.NET for SQL Server: SqlConnection, SqlCommand, SqlDataReader -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
